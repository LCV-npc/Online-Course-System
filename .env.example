# Backend (Spring Boot). Spring does not load this file automatically; export
# these values in your shell/IDE or use a local environment loader.
DB_URL=jdbc:mysql://127.0.0.1:3306/edu_online?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USER=edupro_app
DB_PASSWORD=replace-with-a-local-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/redirect

# Optional OAuth2 providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional one-time development admin bootstrap (disabled by default)
SEED_ADMIN_ENABLED=false
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=replace-with-at-least-12-characters

# Optional demo instructors and IT courses (disabled by default)
SEED_DEMO_ENABLED=false

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080
